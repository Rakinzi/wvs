# Copy to .env.docker or export these values before running Docker Compose.
# Do not commit real secrets.

APP_ENV=development
SECRET_KEY=change-me
JWT_SECRET_KEY=change-me-too

FRONTEND_PORT=8080
BACKEND_PORT=5001
FRONTEND_BASE_URL=http://localhost:8080
FRONTEND_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=http://localhost:5001

MYSQL_DATABASE=wvs
MYSQL_USER=wvs
MYSQL_PASSWORD=wvs_password
MYSQL_ROOT_PASSWORD=root_password_change_me
DATABASE_URL=mysql+pymysql://wvs:wvs_password@db:3306/wvs

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
RATELIMIT_STORAGE_URI=redis://redis:6379/2

SECURITY_WORKER_CONCURRENCY=2
UX_WORKER_CONCURRENCY=1

LIGHTHOUSE_ENABLED=false
ZAP_ENABLED=true
ZAP_API_KEY=
ZAP_PORT=8081
CLAMAV_ENABLED=false

# Optional AI visual review for product-readiness scans.
# Gemini has a free tier; create an API key in Google AI Studio.
VISUAL_AI_ENABLED=false
VISUAL_AI_PROVIDER=gemini
VISUAL_AI_API_KEY=
VISUAL_AI_MODEL=gemini-2.5-flash-lite
VISUAL_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
VISUAL_AI_MAX_SCREENSHOTS_PER_SCAN=3

# Email delivery for verification and password reset emails.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
GMAIL_USER=you@example.com
GMAIL_APP_PASSWORD=your-gmail-app-password
SMTP_FROM_EMAIL=you@example.com
